# MiniMax (Mavis) — chat completions, OpenAI-compatible
LLM_API_KEY=eyJ...
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-Text-01

# Optional: set to 1 to skip all LLM calls and use deterministic templates.
# Useful for offline development and CI.
LLM_DISABLED=0

# Azure Application Insights / Log Analytics (production)
# App Insights query endpoint: https://api.applicationinsights.io/v1/apps/{appId}/query
APPINSIGHTS_APP_ID=
APPINSIGHTS_API_KEY=
APPINSIGHTS_WORKSPACE_ID=

# Email sender (dry-run by default — see tools/email_sender.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=payments-reports@example.com
# Set to 1 to force dry-run even when SMTP is configured.
EMAIL_DRY_RUN=1